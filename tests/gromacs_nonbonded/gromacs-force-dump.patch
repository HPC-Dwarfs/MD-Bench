diff --git a/src/gromacs/nbnxm/benchmark/bench_setup.cpp b/src/gromacs/nbnxm/benchmark/bench_setup.cpp
index 7939050..243d253 100644
--- a/src/gromacs/nbnxm/benchmark/bench_setup.cpp
+++ b/src/gromacs/nbnxm/benchmark/bench_setup.cpp
@@ -418,6 +418,27 @@ static void setupAndRunInstance(const BenchmarkSystem&         system,
                 &nrnb);
     }
 
+    if (!doWarmup && !options.forceOutputFile.empty())
+    {
+        // Forces of the single pre-iteration (which clears the force buffer first)
+        std::vector<gmx::RVec> forces(system.coordinates.size(), gmx::RVec(0, 0, 0));
+        nbv->atomdata_add_nbat_f_to_f(AtomLocality::Local, forces);
+        FILE* fp = std::fopen(options.forceOutputFile.c_str(), "w");
+        const PairlistSet& pls = nbv->pairlistSets().pairlistSet(InteractionLocality::Local);
+        std::fprintf(fp, "# natoms %zu\n", forces.size());
+        std::fprintf(fp, "# pairs_ljq %ld lj %ld q %ld\n", long(pls.natpair_ljq_), long(pls.natpair_lj_), long(pls.natpair_q_));
+        if (options.computeVirialAndEnergy)
+        {
+            std::fprintf(fp, "# energy_lj %.9g\n", double(enerd.grpp.energyGroupPairTerms[NonBondedEnergyTerms::LJSR][0]));
+            std::fprintf(fp, "# energy_coulomb %.9g\n", double(enerd.grpp.energyGroupPairTerms[NonBondedEnergyTerms::CoulombSR][0]));
+        }
+        for (size_t i = 0; i < forces.size(); i++)
+        {
+            std::fprintf(fp, "%zu %.9g %.9g %.9g\n", i, double(forces[i][XX]), double(forces[i][YY]), double(forces[i][ZZ]));
+        }
+        std::fclose(fp);
+    }
+
     const int numIterations = (doWarmup ? options.numWarmupIterations : options.numIterations);
     const PairlistSet& pairlistSet = nbv->pairlistSets().pairlistSet(InteractionLocality::Local);
     const Index numPairs = pairlistSet.natpair_ljq_ + pairlistSet.natpair_lj_ + pairlistSet.natpair_q_;
